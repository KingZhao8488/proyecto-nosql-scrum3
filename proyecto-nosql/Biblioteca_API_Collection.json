                "raw": "{{base_url}}/libros/{{libro_id}}",
                "host": ["{{base_url}}"],
                "path": ["libros", "{{libro_id}}"]
                }
            },
            "response": []
            },
            {
            "name": "Actualizar Libro",
            "request": {
                "method": "PUT",
                "header": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                }
                ],
                "body": {
                "mode": "raw",
                "raw": "{\n    \"copias\": 5,\n    \"numeroPaginas\": 420\n}"
                },
