        "item": [
            {
            "name": "Verificar API",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                "raw": "{{base_url}}",
                "host": ["{{base_url}}"]
                }
            },
            "response": []
            }
        ]
        },
        {
        "name": "01 - Libros",
        "item": [
            {
            "name": "Crear Libro",
            "event": [
                {
                "listen": "test",
                "script": {
                    "exec": [
                    "if (pm.response.code === 201) {",
                    "    const jsonData = pm.response.json();",
                    "    pm.collectionVariables.set('libro_id', jsonData._id);",
                    "    pm.test('Libro creado exitosamente', function () {",
                    "        pm.response.to.have.status(201);",
                    "    });",
                    "}"
                    ],
                    "type": "text/javascript"
                }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                }
                ],
                "body": {
                "mode": "raw",
                "raw": "{\n    \"titulo\": \"Cien Años de Soledad\",\n    \"autor\": \"Gabriel García Márquez\",\n    \"isbn\": \"978-0307474728\",\n    \"editorial\": \"Editorial Sudamericana\",\n    \"anioPublicacion\": 1967,\n    \"genero\": \"Realismo mágico\",\n    \"numeroPaginas\": 417,\n    \"copias\": 3\n}"
                },
                "url": {
                "raw": "{{base_url}}/libros",
                "host": ["{{base_url}}"],
                "path": ["libros"]
                }
            },
            "response": []
            },
