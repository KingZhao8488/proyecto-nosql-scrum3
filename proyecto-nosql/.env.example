# Puerto del servidor
PORT=3000

# MongoDB Connection String
# Para MongoDB Atlas (recomendado):
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/bibliotecaDB

# Para MongoDB Local:
# MONGO_URI=mongodb://localhost:27017/bibliotecaDB

# Instrucciones:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza <usuario>, <password> y <cluster> con tus credenciales reales
# 3. NO subas el archivo .env a Git (ya está en .gitignore)